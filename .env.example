# ---------------------------------------------------------------------------
#  OEE Smart Factory - configuration.  Copy to ".env" and edit.  No secrets in code.
# ---------------------------------------------------------------------------

# --- how data gets in --------------------------------------------------------
# direct = simulator runs inside the backend (no Docker/MQTT needed)   mqtt = real path via Mosquitto
INGEST_MODE=direct
MACHINE_COUNT=5            # 5..20 (FR-11)
BACKFILL_DAYS=7            # simulated history used for 1h/8h OEE windows and the 7-day reports (0 = none)

# --- where data is stored ----------------------------------------------------
# memory = no database needed (default)     db = InfluxDB v2 + PostgreSQL (see DATABASE_MANUAL_SETUP_GUIDE.md)
STORAGE_MODE=memory

INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=oee-super-secret-token
INFLUX_ORG=oee-org
INFLUX_BUCKET_RAW=telemetry_raw
INFLUX_BUCKET_AGG=telemetry_agg

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oee_db
POSTGRES_USER=oee_user
POSTGRES_PASSWORD=ChangeMe123

# --- MQTT (only used when INGEST_MODE=mqtt) ----------------------------------
MQTT_HOST=localhost
MQTT_TRANSPORT=websockets   # websockets (SRS) | tcp
# MQTT_PORT=9001            # default: 9001 for websockets, 1883 for tcp

# --- thresholds ----------------------------------------------------------------
ANOMALY_THRESHOLD=85        # % -> Yellow
WHATIF_HORIZON_S=60         # Orange when the projected crossing is this close

# --- users for HTTP Basic auth: user:password:role,... (single tenant) ----------
USERS=manager:manager123:floor_manager,engineer:engineer123:maintenance_engineer,analyst:analyst123:production_analyst,admin:admin123:system_administrator
DEMO_HINTS=true             # show these logins on the sign-in form (turn off outside a demo)

LOG_LEVEL=INFO
LOG_JSON=false
